    {
     "id": 38,
     "name": "Bankdrücken Eng",
     "exercise": 76,
     "description": "<ul>\n<li><strong>Aufbau:</strong> Lege dich flach auf die Bank und greife die Stange schulterbreit (enger als beim normalen Bankdrücken).</li>\n<li><strong>Abwärtsbewegung:</strong> Senke die Stange kontrolliert zu deiner unteren Brust.</li>\n<li><strong>Technik:</strong> Halte deine Ellbogen eng am Oberkörper, lass sie nicht nach außen wandern.</li>\n<li><strong>Aufwärtsbewegung:</strong> Drücke die Stange gerade nach oben und spanne oben deinen Trizeps an.</li>\n</ul>\n",
     "language": 1
    },
    {
     "id": 88,
     "name": "Bench Press Narrow Grip",
     "exercise": 76,
     "description": "<ul>\n<li><strong>Setup:</strong> Lie flat on the bench and grip the bar at shoulder-width (closer than a standard bench press).</li>\n<li><strong>Descent:</strong> Lower the bar with control to your lower chest.</li>\n<li><strong>Form:</strong> Keep your elbows tucked in tight against your torso—do not let them flare out.</li>\n<li><strong>Ascent:</strong> Press the bar straight back up, squeezing your triceps at the top.</li>\n</ul>\n",
     "language": 2
    }
   ]
